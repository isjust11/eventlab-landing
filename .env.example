# Nest API as seen by the Next server (template catalog for SSR)
EVENTLAB_API_URL=http://localhost:4000
# Nest API as seen by the browser (sign-in, my events, guests, uploads)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Invite host: /template/:slug demos, /preview live editor preview, /invite/:slug published invites.
# Its NEXT_PUBLIC_ADMIN_ORIGINS must include this site's origin for the live preview.
NEXT_PUBLIC_INVITE_HOST_URL=http://localhost:3000
